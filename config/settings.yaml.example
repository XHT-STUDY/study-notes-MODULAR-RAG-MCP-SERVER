# Modular RAG MCP Server - 配置模板
# 复制为 config/settings.yaml 后填写；密钥/覆盖可写入 config/.env（load_settings 自动加载）。
# 优先级：进程环境变量 > config/.env > settings.yaml。密钥请勿写入本文件。

# =============================================================================
# LLM Configuration
# =============================================================================
llm:
  provider: "qwen"        # openai | azure | ollama | deepseek | qwen（与代码注册一致，无 gemini）
  model: "qwen-turbo"
  deployment_name: ""
  azure_endpoint: ""
  api_version: ""
  api_key: ""             # 用环境变量 LLM_API_KEY 注入
  base_url: ""            # 用环境变量 LLM_BASE_URL 注入（Ollama/私有化网关）
  temperature: 0.0
  max_tokens: 4096

# =============================================================================
# Embedding Configuration
# =============================================================================
embedding:
  provider: "qwen"        # openai | azure | ollama | qwen
  model: "text-embedding-v3"
  dimensions: 1024
  azure_endpoint: ""
  deployment_name: ""
  api_version: ""
  api_key: ""             # 环境变量 EMBEDDING_API_KEY
  base_url: ""            # 环境变量 EMBEDDING_BASE_URL

# =============================================================================
# Vision LLM Configuration（图像理解/字幕）
# =============================================================================
vision_llm:
  enabled: true
  provider: "qwen"        # openai | azure | ollama | qwen
  model: "qwen-vl-max"
  azure_endpoint: ""
  deployment_name: ""
  api_version: ""
  api_key: ""             # 环境变量 VISION_API_KEY
  base_url: ""            # 环境变量 VISION_BASE_URL
  max_image_size: 2048

# =============================================================================
# Vector Store Configuration
# =============================================================================
vector_store:
  provider: "chroma"      # chroma | qdrant | pinecone（本地默认 chroma）
  persist_directory: "./data/db/chroma"
  collection_name: "knowledge_hub"

# =============================================================================
# Retrieval Configuration
# =============================================================================
retrieval:
  dense_top_k: 20
  sparse_top_k: 20
  fusion_top_k: 10
  rrf_k: 60

# =============================================================================
# Rerank Configuration
# =============================================================================
rerank:
  enabled: false          # true 时用 LLM/cross-encoder 重排
  provider: "none"        # none | llm | cross_encoder
  model: "none"
  top_k: 5

# =============================================================================
# Evaluation Configuration
# =============================================================================
evaluation:
  enabled: true
  provider: "custom"      # custom | ragas | composite
  # Phase 3: 源级为主（source_hit_rate / source_mrr），chunk 级为辅（hit_rate / mrr）。
  # 默认不用 ragas 指标（faithfulness 等），避免 custom 后端误配；ragas/composite 由 metrics 按需补充。
  metrics:
    - "hit_rate"
    - "mrr"
    - "source_hit_rate"
    - "source_mrr"
  # composite 后端专用：组合的子后端列表（如 [custom, ragas]）。provider != composite 时忽略。
  backends: []

# =============================================================================
# Observability Configuration
# =============================================================================
observability:
  log_level: "INFO"
  trace_enabled: true
  trace_file: "./logs/traces.jsonl"
  structured_logging: true

# =============================================================================
# Ingestion Configuration
# =============================================================================
ingestion:
  chunk_size: 1000
  chunk_overlap: 200
  splitter: "recursive"
  batch_size: 10
  chunk_refiner:
    use_llm: true
  metadata_enricher:
    use_llm: true

# =============================================================================
# Answer Generator Configuration（Phase 2 生成式问答）
# =============================================================================
answer_generator:
  enabled: true          # false → NoneAnswerGenerator，保持检索-only
  provider: "extractive" # extractive（无 key 离线）| llm（复用 llm 配置，需密钥）| template（基线/测试）| none
  model: ""              # 可覆盖 llm.model；留空用 settings.llm.model（仅 llm provider 生效）
  temperature: 0.0
  max_tokens: 1024
  confidence_threshold: 0.5   # 低于此值 → answer 追加"资料不足"提示 + confidence 降级
  max_chunks: 3               # 参与生成的 top chunk 数

# =============================================================================
# Agentic RAG（Phase 6 已实施，默认关闭；启用后走 Agent 循环而非直通检索）
# 对应 src/core/settings.py 的 AgentSettings 可选块，完整 schema 见 §9.4。
# 可用 AGENT_ENABLED=true/false 环境变量翻转 enabled（_coerce_bool 宽容解析）。
# =============================================================================
agent:
  enabled: false            # false → NoneAgent，保持 query_knowledge_hub 直通
  strategy: "react"         # react | plan_and_execute | self_ask
  max_iterations: 5
  router: { enabled: true, provider: "rule" }
  memory: { enabled: false, backend: "none", window_size: 10 }
  reflection: { enabled: true, max_retrieval_rounds: 2 }
  tools:
    - "query_knowledge_hub"
    - "list_collections"
    - "get_document_summary"

# =============================================================================
# Prompt 模板映射（Phase 5）
# 每个 role → prompts/ 目录下的模板文件名（不含 .md）。留空/省略 = 缺省 role 名。
# 修改 prompts/*.md 正文后，运行 scripts/prompts.py --update-checksums 回填
# checksum；scripts/prompts.py --verify 校验（CI 同款）。
# =============================================================================
prompts:
  chunk_refinement: ""       # 缺省 → prompts/chunk_refinement.md
  metadata_enrichment: ""    # 缺省 → prompts/metadata_enrichment.md
  image_captioning: ""       # 缺省 → prompts/image_captioning.md
  rerank: ""                 # 缺省 → prompts/rerank.md（rerank.enabled=false 时不加载）
